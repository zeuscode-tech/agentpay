SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAY_TO=
SOLANA_PRIVATE_KEY=
FACILITATOR_URL=https://x402.org/facilitator

# Optional Devnet fallback when official USDC faucet access is unavailable.
# Set both values together. PAYMENT_AMOUNT is in atomic token units.
PAYMENT_ASSET=
PAYMENT_AMOUNT=

# Public browser configuration for apps/web. These are addresses, not secrets.
NEXT_PUBLIC_AGENTPAY_API_URL=http://127.0.0.1:4021
NEXT_PUBLIC_SOLANA_PAY_TO=
NEXT_PUBLIC_PAYMENT_ASSET=
NEXT_PUBLIC_PAYMENT_AMOUNT=

# The local extractive mode works without external credentials.
AI_SUMMARIZER_MODE=local

# For production-quality LLM summaries, switch the mode to gateway and set
# either AI_GATEWAY_API_KEY locally or VERCEL_OIDC_TOKEN in a deployment.
# Choose a current provider/model ID from https://ai-gateway.vercel.sh/v1/models.
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
