{
  "name": "@agentpay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "token:mint-dev": "tsx scripts/setup-devnet-test-token.ts",
    "tokens:setup": "tsx scripts/setup-devnet-token-accounts.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wallets:setup": "tsx scripts/setup-dev-wallets.ts"
  },
  "dependencies": {
    "@agentpay/config": "workspace:*",
    "@solana/kit": "^8.5.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "ai": "^7.0.155",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
